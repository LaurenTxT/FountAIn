{
  "appId": "com.fountain.desktop",
  "productName": "FountAIn",
  "directories": { "output": "release" },
  "asar": false,
  "electronDist": "node_modules/electron/dist",
  "npmRebuild": false,
  "files": ["dist/**/*", "package.json", "package-lock.json", "!node_modules/**/*", "!**/*.map"],
  "afterPack": "scripts/runtime-dependencies.mjs",
  "afterSign": "scripts/build-manifest.mjs",
  "win": {
    "target": ["nsis", "portable"],
    "icon": "build/fountain.ico",
    "requestedExecutionLevel": "asInvoker",
    "signAndEditExecutable": true
  },
  "nsis": {
    "artifactName": "FountAIn-Setup-${version}.exe",
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "FountAIn",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true
  },
  "portable": {
    "artifactName": "FountAIn-${version}-Windows.exe",
    "requestExecutionLevel": "user"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "build/fountain.png",
    "category": "Development",
    "artifactName": "FountAIn-${version}-${arch}.${ext}",
    "desktop": {
      "Name": "FountAIn",
      "Comment": "FountAIn — 本地多模型 AI 协作工作台",
      "StartupWMClass": "fountain"
    }
  }
}
